# ==============================================================================
# SPLUNK ENTERPRISE DETECTION & DASHBOARD QUERIES (SPL)
# Project: Proactive Threat Detection and Log Analysis - Zimbra SIEM Pipeline
# Target: Zimbra SNMP / Swatchdog Remote Command Injection (CVE-2024-45519)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE DETECTION QUERY (Phase 3 Search)
# ------------------------------------------------------------------------------
# Filters raw log streams and isolates swatchdog executions containing dangerous commands
source="*zimbra*" "swatchdog" ("wget" OR "sh" OR "curl" OR "rm")


# ------------------------------------------------------------------------------
# 2. DASHBOARD METRIC: Single Value Alert Counter (0 -> 1 -> N)
# ------------------------------------------------------------------------------
# Powers the "Active Exploitation Attempts" Single Value widget on the dashboard
source="*zimbra*" ("swatchdog" OR "snmp_notify") ("wget" OR "sh" OR "curl" OR "rm" OR "bash")
| stats count as "Malicious Payloads Detected"


# ------------------------------------------------------------------------------
# 3. DASHBOARD PIE / BAR CHART: Traffic Classification Breakdown
# ------------------------------------------------------------------------------
# Segregates baseline operational traffic vs malicious attack attempts
source="*zimbra*"
| eval Traffic_Type=if((like(_raw, "%swatchdog%") OR like(_raw, "%snmp_notify%")) AND (like(_raw, "%wget%") OR like(_raw, "%sh%") OR like(_raw, "%curl%") OR like(_raw, "%rm%")), "CRITICAL: Malicious Exploit", "NORMAL: Benign Traffic")
| stats count by Traffic_Type


# ------------------------------------------------------------------------------
# 4. DASHBOARD TIMELINE: Timechart of Attack Attempts
# ------------------------------------------------------------------------------
# Visualizes the frequency and time of exploitation attempts
source="*zimbra*" "swatchdog" ("wget" OR "sh" OR "curl" OR "rm")
| timechart count span=1m by host


# ------------------------------------------------------------------------------
# 5. SOC INCIDENT RESPONSE LOG TABLE (Field Extraction)
# ------------------------------------------------------------------------------
# Parses timestamps, thread IDs, log levels, and raw execution payloads for triage
source="*zimbra*"
| rex field=_raw "(?<log_time>^\d{4}-\d{2}-\d{2}\s\d{2}:\d{2}:\d{2})\s+(?<log_level>\w+)\s+\[(?<thread>[^\]]+)\]\s+(?<component>[^\s]+)\s+-\s+(?<event_details>.*)"
| eval Severity=if(log_level="ALERT" OR like(event_details, "%malicious%") OR like(event_details, "%wget%"), "HIGH / ATTACK", "LOW / NORMAL")
| table log_time log_level thread component Severity event_details
| sort - log_time
